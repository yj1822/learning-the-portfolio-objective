# Path to the trading-data-hub checkout. Do not commit machine-specific values.
TRADING_DATA_HUB_ROOT=

# Optional explicit path to trading-data-hub/config/sources.yaml.
DATAHUB_CONFIG=

# Required only for real licensed downloads through trading-data-hub.
WRDS_USERNAME=
WRDS_PASSWORD=

# Optional read-only loader overrides for alternate processed copies.
IEF_DATA_CONFIG=
IEF_DATA_ROOT=
IEF_MASTER_PANEL_PATH=

# Optional font directory for historical figure-generation scripts.
IEF_FONT_ROOT=

